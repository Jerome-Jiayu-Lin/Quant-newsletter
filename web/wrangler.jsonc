{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jerome-brief",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jeromebrief.com",
      "custom_domain": true
    },
    {
      "pattern": "preview.jeromebrief.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_EDITIONS",
      "bucket_name": "jerome-brief-public",
      "preview_bucket_name": "jerome-brief-preview"
    }
  ],
  "env": {
    "preview": {
      "name": "jerome-brief-preview",
      "workers_dev": true,
      "routes": [],
      "r2_buckets": [
        {
          "binding": "PUBLIC_EDITIONS",
          "bucket_name": "jerome-brief-preview"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
